<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 880 500" width="880" height="500">
  <defs>
    <linearGradient id="skyGradRepaired" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#141e30"/>
      <stop offset="100%" stop-color="#243b55"/>
    </linearGradient>
    <linearGradient id="roadGradRepaired" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#2c343c"/>
      <stop offset="100%" stop-color="#12161a"/>
    </linearGradient>
  </defs>

  <rect width="880" height="240" fill="url(#skyGradRepaired)"/>
  <rect y="240" width="880" height="260" fill="url(#roadGradRepaired)"/>

  <polygon points="440,240 440,240 0,500 880,500" fill="#1b2126" opacity="0.6"/>
  <line x1="440" y1="240" x2="440" y2="500" stroke="#f1c40f" stroke-width="4" stroke-dasharray="25,20" opacity="0.7"/>
  <line x1="440" y1="240" x2="160" y2="500" stroke="#ffffff" stroke-width="3" opacity="0.4"/>
  <line x1="440" y1="240" x2="720" y2="500" stroke="#ffffff" stroke-width="3" opacity="0.4"/>

  <!-- Freshly Asphated Patch (Repaired Pothole) -->
  <ellipse cx="500" cy="310" rx="115" ry="58" fill="#1e2227" stroke="#334155" stroke-width="2"/>
  <ellipse cx="500" cy="310" rx="90" ry="40" fill="#252a32" opacity="0.95"/>

  <!-- PWD Repair Inspection Bounding Box -->
  <rect x="375" y="235" width="250" height="150" fill="#10b981" fill-opacity="0.12" stroke="#10b981" stroke-width="3" stroke-dasharray="8,4"/>
  
  <!-- Stamp -->
  <rect x="375" y="205" width="220" height="28" fill="#10b981" rx="4"/>
  <text x="385" y="224" fill="#0b0f17" font-family="monospace" font-size="13" font-weight="bold">✓ REPAIRED &amp; SEALED (PWD)</text>

  <!-- HUD Overlay -->
  <rect width="880" height="42" fill="#000000" fill-opacity="0.85"/>
  <circle cx="25" cy="21" r="7" fill="#10b981"/>
  <text x="40" y="26" fill="#ffffff" font-family="monospace" font-size="14" font-weight="bold">PWD ZONE 3 FIELD VERIFICATION CAM | POST-REPAIR</text>
  <text x="860" y="26" fill="#10b981" font-family="monospace" font-size="13" text-anchor="end">WORK ORDER #1042 | COMPLETED</text>

  <rect y="450" width="880" height="50" fill="#000000" fill-opacity="0.85"/>
  <text x="20" y="472" fill="#00e5ff" font-family="monospace" font-size="13" font-weight="bold">LOCATION: Western Express Highway (Santacruz Flyover) | 19.0760° N, 72.8777° E</text>
  <text x="20" y="490" fill="#10b981" font-family="monospace" font-size="12">Hot-mix asphalt patch compaction verified. Level tolerance &lt; 3mm. Ready for Municipal Closure.</text>
  <text x="860" y="482" fill="#aaaaaa" font-family="monospace" font-size="12" text-anchor="end">PWD Western Div</text>
</svg>
