<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 880 500" width="880" height="500">
  <defs>
    <linearGradient id="skyGrad2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#2c3e50"/>
      <stop offset="100%" stop-color="#34495e"/>
    </linearGradient>
    <linearGradient id="roadGrad2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#232b32"/>
      <stop offset="100%" stop-color="#151a1e"/>
    </linearGradient>
  </defs>

  <rect width="880" height="240" fill="url(#skyGrad2)"/>
  <rect y="240" width="880" height="260" fill="url(#roadGrad2)"/>

  <!-- Vehicles in traffic -->
  <rect x="180" y="270" width="90" height="80" fill="#7f8c8d" rx="6"/>
  <rect x="300" y="260" width="110" height="95" fill="#e67e22" rx="6"/>
  <rect x="440" y="240" width="160" height="130" fill="#2980b9" rx="8"/>
  <rect x="630" y="280" width="85" height="70" fill="#f1c40f" rx="6"/>

  <!-- Large Traffic Density ROI Box -->
  <rect x="150" y="210" width="590" height="190" fill="#e67e22" fill-opacity="0.12" stroke="#e67e22" stroke-width="3" stroke-dasharray="10,5"/>
  <rect x="150" y="180" width="220" height="28" fill="#e67e22" rx="4"/>
  <text x="160" y="199" fill="#ffffff" font-family="monospace" font-size="13" font-weight="bold">CONGESTION DETECTED (95%)</text>

  <!-- HUD Overlay -->
  <rect width="880" height="42" fill="#000000" fill-opacity="0.8"/>
  <circle cx="25" cy="21" r="7" fill="#e67e22"/>
  <text x="40" y="26" fill="#ffffff" font-family="monospace" font-size="14" font-weight="bold">MARGADRISHTI ON-BOARD EDGE AI CAM | CAM_FRONT</text>
  <text x="860" y="26" fill="#00ffcc" font-family="monospace" font-size="13" text-anchor="end">Traffic Density: SEVERE (14 vehicles)</text>

  <rect y="450" width="880" height="50" fill="#000000" fill-opacity="0.85"/>
  <text x="20" y="472" fill="#00e5ff" font-family="monospace" font-size="13" font-weight="bold">BUS_105 | R40 | 8.2 km/h (Drop 74.3%) | 19.1136° N, 72.8697° E</text>
  <text x="20" y="490" fill="#f39c12" font-family="monospace" font-size="12">New Link Road | Cause: TRAFFIC_CONGESTION | Corridor Stoppage</text>
  <text x="860" y="482" fill="#aaaaaa" font-family="monospace" font-size="12" text-anchor="end">SIH 2026 PS 26124 | BEL</text>
</svg>
