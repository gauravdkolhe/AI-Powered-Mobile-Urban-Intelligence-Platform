<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 880 500" width="880" height="500">
  <defs>
    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#141e30"/>
      <stop offset="100%" stop-color="#243b55"/>
    </linearGradient>
    <linearGradient id="roadGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#2c343c"/>
      <stop offset="100%" stop-color="#12161a"/>
    </linearGradient>
  </defs>

  <rect width="880" height="240" fill="url(#skyGrad)"/>
  <rect y="240" width="880" height="260" fill="url(#roadGrad)"/>

  <polygon points="440,240 440,240 0,500 880,500" fill="#1b2126" opacity="0.6"/>
  <line x1="440" y1="240" x2="440" y2="500" stroke="#f1c40f" stroke-width="4" stroke-dasharray="25,20" opacity="0.7"/>
  <line x1="440" y1="240" x2="160" y2="500" stroke="#ffffff" stroke-width="3" opacity="0.4"/>
  <line x1="440" y1="240" x2="720" y2="500" stroke="#ffffff" stroke-width="3" opacity="0.4"/>

  <!-- Pothole crater representation -->
  <ellipse cx="500" cy="310" rx="110" ry="55" fill="#080b0e" opacity="0.95"/>
  <ellipse cx="500" cy="310" rx="80" ry="35" fill="#030406" opacity="0.98"/>

  <!-- AI Bounding Box Overlay -->
  <rect x="380" y="240" width="240" height="140" fill="#e74c3c" fill-opacity="0.15" stroke="#e74c3c" stroke-width="3" stroke-dasharray="8,4"/>
  <path d="M 380 260 L 380 240 L 400 240 M 600 240 L 620 240 L 620 260 M 380 360 L 380 380 L 400 380 M 600 380 L 620 380 L 620 360" stroke="#e74c3c" stroke-width="4" fill="none"/>

  <rect x="380" y="210" width="160" height="26" fill="#e74c3c" rx="4"/>
  <text x="388" y="228" fill="#ffffff" font-family="monospace" font-size="13" font-weight="bold">POTHOLE (93%)</text>

  <!-- HUD Overlay -->
  <rect width="880" height="42" fill="#000000" fill-opacity="0.8"/>
  <circle cx="25" cy="21" r="7" fill="#e74c3c"/>
  <text x="40" y="26" fill="#ffffff" font-family="monospace" font-size="14" font-weight="bold">MARGADRISHTI ON-BOARD EDGE AI CAM | CAM_FRONT</text>
  <text x="860" y="26" fill="#00ffcc" font-family="monospace" font-size="13" text-anchor="end">AI Conf: 93% | Cause: ROAD_DEFECT</text>

  <rect y="450" width="880" height="50" fill="#000000" fill-opacity="0.85"/>
  <text x="20" y="472" fill="#00e5ff" font-family="monospace" font-size="13" font-weight="bold">BUS_102 | R12 | 12.4 km/h (Drop 63.6%) | 19.0760° N, 72.8777° E</text>
  <text x="20" y="490" fill="#f39c12" font-family="monospace" font-size="12">Western Express Highway | Depth: ~14.5cm | Area: 0.42m²</text>
  <text x="860" y="482" fill="#aaaaaa" font-family="monospace" font-size="12" text-anchor="end">SIH 2026 PS 26124 | BEL</text>
</svg>
